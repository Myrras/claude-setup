{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/ORCHESTRATOR.md\"", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/block-main-edits.sh\"", "timeout": 5 }] }
    ]
  }
}
